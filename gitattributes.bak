# PowerShell scripts must be UTF-8 with BOM
*.ps1 text eol=crlf working-tree-encoding=UTF-8-BOM
*.psm1 text eol=crlf working-tree-encoding=UTF-8-BOM
*.psd1 text eol=crlf working-tree-encoding=UTF-8-BOM

# Bash scripts must be UTF-8 LF
*.sh text eol=lf

# Markdown stays UTF-8
*.md text

# Prevent accidental binary detection
*.json text
